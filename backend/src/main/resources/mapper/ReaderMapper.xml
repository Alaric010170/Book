<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.library.mapper.ReaderMapper">

    <resultMap id="ReaderResult" type="com.library.entity.Reader">
        <id property="id" column="id"/>
        <result property="name" column="name"/>
        <result property="email" column="email"/>
        <result property="level" column="level"/>
        <result property="borrows" column="borrows"/>
        <result property="avatar" column="avatar"/>
    </resultMap>

    <select id="findAll" resultMap="ReaderResult">
        SELECT * FROM t_reader ORDER BY id DESC
    </select>

    <select id="findById" resultMap="ReaderResult">
        SELECT * FROM t_reader WHERE id = #{id}
    </select>

    <select id="findByLevel" resultMap="ReaderResult">
        SELECT * FROM t_reader WHERE level = #{level}
    </select>

    <select id="search" resultMap="ReaderResult">
        SELECT * FROM t_reader
        WHERE name LIKE CONCAT('%', #{keyword}, '%')
           OR email LIKE CONCAT('%', #{keyword}, '%')
           OR id LIKE CONCAT('%', #{keyword}, '%')
        ORDER BY id DESC
    </select>

    <insert id="insert">
        INSERT INTO t_reader (id, name, email, level, borrows, avatar)
        VALUES (#{id}, #{name}, #{email}, #{level}, #{borrows}, #{avatar})
    </insert>

    <update id="update">
        UPDATE t_reader
        <set>
            <if test="name != null">name = #{name},</if>
            <if test="email != null">email = #{email},</if>
            <if test="level != null">level = #{level},</if>
            <if test="borrows != null">borrows = #{borrows},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM t_reader WHERE id = #{id}
    </delete>

    <select id="count" resultType="long">
        SELECT COUNT(*) FROM t_reader
    </select>

    <select id="countByLevel" resultType="long">
        SELECT COUNT(*) FROM t_reader WHERE level = #{level}
    </select>

</mapper>
