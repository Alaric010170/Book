<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.library.mapper.BookMapper">

    <resultMap id="BookResult" type="com.library.entity.Book">
        <id property="id" column="id"/>
        <result property="cover" column="cover"/>
        <result property="title" column="title"/>
        <result property="author" column="author"/>
        <result property="isbn" column="isbn"/>
        <result property="category" column="category"/>
        <result property="status" column="status"/>
    </resultMap>

    <select id="findAll" resultMap="BookResult">
        SELECT * FROM t_book ORDER BY id
    </select>

    <select id="findById" resultMap="BookResult">
        SELECT * FROM t_book WHERE id = #{id}
    </select>

    <select id="findByCategory" resultMap="BookResult">
        SELECT * FROM t_book WHERE category = #{category}
    </select>

    <select id="findByStatus" resultMap="BookResult">
        SELECT * FROM t_book WHERE status = #{status}
    </select>

    <select id="search" resultMap="BookResult">
        SELECT * FROM t_book
        WHERE title LIKE CONCAT('%', #{keyword}, '%')
           OR author LIKE CONCAT('%', #{keyword}, '%')
           OR isbn LIKE CONCAT('%', #{keyword}, '%')
        ORDER BY id
    </select>

    <insert id="insert">
        INSERT INTO t_book (id, cover, title, author, isbn, category, status)
        VALUES (#{id}, #{cover}, #{title}, #{author}, #{isbn}, #{category}, #{status})
    </insert>

    <update id="update">
        UPDATE t_book
        <set>
            <if test="cover != null">cover = #{cover},</if>
            <if test="title != null">title = #{title},</if>
            <if test="author != null">author = #{author},</if>
            <if test="isbn != null">isbn = #{isbn},</if>
            <if test="category != null">category = #{category},</if>
            <if test="status != null">status = #{status},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM t_book WHERE id = #{id}
    </delete>

    <select id="count" resultType="long">
        SELECT COUNT(*) FROM t_book
    </select>

    <select id="countByStatus" resultType="long">
        SELECT COUNT(*) FROM t_book WHERE status = #{status}
    </select>

</mapper>
